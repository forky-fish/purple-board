#!/usr/bin/env node
// session-dock: render a session card (Markdown) as a sidebar next to a Claude Code session.
//
//   session-dock open [dir]     split the current tmux window and show the dock on the right
//   session-dock watch [dir]    render continuously (what the dock pane runs)
//   session-dock render [dir]   render once to stdout
//   session-dock init [dir]     create .claude/dock.md from the template if missing
//   session-dock serve [dir]    browser dock on http://127.0.0.1:7777 (SESSION_DOCK_PORT)
//   session-dock reset [dir]    start a new "since you were away" window
//
// The session-dock plugin writes ~/.claude/session-dock/sessions/<session id>.json; all views
// read it. Several sessions can share a directory: the newest one wins unless you pass
// --session <id> (or set SESSION_DOCK_SESSION). SESSION_DOCK_HOME overrides ~/.claude/session-dock.

// The card lives at <dir>/.claude/dock.md (override with SESSION_DOCK_FILE).
// Live git facts (branch, last commit, uncommitted files) are appended below the card.

'use strict';
const fs = require('fs');
const path = require('path');
const { execFileSync, spawnSync } = require('child_process');

const WIDTH_DEFAULT = 44;
const REFRESH_MS = 5000;

const esc = (c) => `\x1b[${c}m`;
const S = {
  reset: esc(0), bold: esc(1), dim: esc(2), italic: esc(3), under: esc(4),
  purple: esc('38;5;141'), cyan: esc(36), green: esc(32), yellow: esc(33), red: esc(31), grey: esc('38;5;245'),
};

function cardPath(dir) {
  return process.env.SESSION_DOCK_FILE || path.join(dir, '.claude', 'dock.md');
}

function visibleLength(s) {
  return s.replace(/\x1b\[[0-9;]*m/g, '').length;
}

// Wrap text that may contain ANSI codes to the given width.
function wrap(text, width, indent = '') {
  const words = text.split(/(\s+)/);
  const lines = [];
  let line = '';
  for (const w of words) {
    if (/^\s+$/.test(w)) { if (line) line += ' '; continue; }
    if (line && visibleLength(line) + visibleLength(w) > width) {
      lines.push(line.trimEnd());
      line = indent + w;
    } else {
      line += w;
    }
  }
  if (line.trim()) lines.push(line.trimEnd());
  return lines.length ? lines : [''];
}

function inline(s) {
  return s
    .replace(/`([^`]+)`/g, `${S.cyan}$1${S.reset}`)
    .replace(/\*\*([^*]+)\*\*/g, `${S.bold}$1${S.reset}`)
    .replace(/(^|[^*])\*([^*]+)\*/g, `$1${S.italic}$2${S.reset}`)
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, `${S.under}$1${S.reset}`)
    .replace(/\b(DONE|OK)\b/g, `${S.green}$1${S.reset}`)
    .replace(/\b(BLOCKED|FAIL|ERROR)\b/g, `${S.red}$1${S.reset}`)
    .replace(/\b(WAIT|GATE|TODO)\b/g, `${S.yellow}$1${S.reset}`);
}

function renderTable(rows, width) {
  const cells = rows
    .filter((r) => !/^\s*\|?\s*:?-{2,}/.test(r))
    .map((r) => r.trim().replace(/^\||\|$/g, '').split('|').map((c) => c.trim()));
  const out = [];
  // Narrow sidebar: render each row as "key: value" pairs instead of a grid.
  const [head, ...body] = cells;
  if (!body.length) return head.map((c) => inline(c));
  if (head.length === 2) {
    // Key/value table: one line per row.
    for (const [k, v] of body) out.push(...wrap(`${S.grey}${k}:${S.reset} ${inline(v || '')}`, width, '  '));
    return out;
  }
  for (const row of body) {
    row.forEach((c, i) => {
      const label = head[i] ? `${S.grey}${head[i]}:${S.reset} ` : '';
      out.push(...wrap(label + inline(c), width, '  '));
    });
    out.push('');
  }
  return out;
}

function renderMarkdown(md, width) {
  const out = [];
  const lines = md.replace(/\r/g, '').split('\n');
  let inCode = false;
  let table = [];
  const flushTable = () => { if (table.length) { out.push(...renderTable(table, width)); table = []; } };

  for (const raw of lines) {
    if (/^```/.test(raw)) { flushTable(); inCode = !inCode; continue; }
    if (inCode) { out.push(`${S.cyan}${raw.slice(0, width)}${S.reset}`); continue; }
    if (/^\s*\|/.test(raw)) { table.push(raw); continue; }
    flushTable();

    let m;
    if ((m = raw.match(/^(#{1,6})\s+(.*)/))) {
      const level = m[1].length;
      if (out.length && out[out.length - 1] !== '') out.push('');
      if (level === 1) {
        out.push(`${S.bold}${S.purple}${m[2].toUpperCase()}${S.reset}`);
        out.push(`${S.purple}${'━'.repeat(Math.min(width, m[2].length))}${S.reset}`);
      } else {
        out.push(`${S.bold}${S.purple}${m[2]}${S.reset}`);
      }
    } else if ((m = raw.match(/^(\s*)[-*+]\s+\[( |x|X)\]\s+(.*)/))) {
      const box = m[2] === ' ' ? `${S.yellow}☐${S.reset}` : `${S.green}☑${S.reset}`;
      out.push(...wrap(`${m[1]}${box} ${inline(m[3])}`, width, `${m[1]}  `));
    } else if ((m = raw.match(/^(\s*)[-*+]\s+(.*)/))) {
      out.push(...wrap(`${m[1]}${S.purple}•${S.reset} ${inline(m[2])}`, width, `${m[1]}  `));
    } else if ((m = raw.match(/^(\s*)(\d+)[.)]\s+(.*)/))) {
      out.push(...wrap(`${m[1]}${S.purple}${m[2]}.${S.reset} ${inline(m[3])}`, width, `${m[1]}   `));
    } else if ((m = raw.match(/^>\s?(.*)/))) {
      out.push(...wrap(`${S.grey}│${S.reset} ${S.italic}${inline(m[1])}${S.reset}`, width, `${S.grey}│${S.reset} `));
    } else if (/^\s*(-{3,}|\*{3,})\s*$/.test(raw)) {
      out.push(`${S.grey}${'─'.repeat(width)}${S.reset}`);
    } else if (raw.trim() === '') {
      if (out.length && out[out.length - 1] !== '') out.push('');
    } else {
      out.push(...wrap(inline(raw.trim()), width));
    }
  }
  flushTable();
  return out;
}

function git(dir, args) {
  try {
    return execFileSync('git', ['-C', dir, ...args], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();
  } catch {
    return null;
  }
}

function liveFacts(dir, width) {
  const branch = git(dir, ['rev-parse', '--abbrev-ref', 'HEAD']);
  if (branch === null) return [];
  const last = git(dir, ['log', '-1', '--format=%h %s (%cr)']) || '-';
  const dirty = (git(dir, ['status', '--porcelain']) || '').split('\n').filter(Boolean).length;
  const out = ['', `${S.grey}${'─'.repeat(width)}${S.reset}`, `${S.bold}${S.purple}Live${S.reset}`];
  out.push(...wrap(`${S.grey}branch:${S.reset} ${S.cyan}${branch}${S.reset}`, width, '  '));
  out.push(...wrap(`${S.grey}last:${S.reset} ${last}`, width, '  '));
  out.push(`${S.grey}uncommitted:${S.reset} ${dirty ? `${S.yellow}${dirty}${S.reset}` : `${S.green}0${S.reset}`}`);
  return out;
}

const HOME_DIR = process.env.SESSION_DOCK_HOME || path.join(require('os').homedir(), '.claude', 'session-dock');
const SPARK = '▁▂▃▄▅▆▇█';
let wantedSession = process.env.SESSION_DOCK_SESSION || '';

function readJson(file) {
  try { return JSON.parse(fs.readFileSync(file, 'utf8')); } catch { return null; }
}

function allRecords() {
  const base = path.join(HOME_DIR, 'sessions');
  let names = [];
  try { names = fs.readdirSync(base).filter((n) => n.endsWith('.json')); } catch { /* none yet */ }
  const out = [];
  for (const n of names) {
    const r = readJson(path.join(base, n));
    if (r && r.v === 2 && r.view && r.view.session) out.push(r);
  }
  return out;
}

// The session this view shows: the chosen one, else the newest whose cwd is dir.
function readState(dir) {
  const records = allRecords();
  if (wantedSession) return records.find((r) => r.view.session.id === wantedSession) || null;
  return records.filter((r) => r.view.session.cwd === dir).sort((a, b) => b.updatedAt - a.updatedAt)[0] || null;
}

const label = (k) => ({ five_hour: '5h', seven_day: '7d' }[k] || String(k).slice(0, 7));
const lvl = (p) => (p >= 85 ? S.red : p >= 65 ? S.yellow : S.green);

function meter(p, w = 16) {
  const n = Math.max(0, Math.min(100, Math.round(p ?? 0)));
  const f = Math.round((n / 100) * w);
  return `${lvl(n)}${'█'.repeat(f)}${S.grey}${'░'.repeat(w - f)}${S.reset} ${n}%`;
}

function sparkline(values) {
  if (!values || values.length < 2) return '';
  return values.map((v) => SPARK[Math.min(7, Math.max(0, Math.floor((v / 100) * 8)))]).join('');
}

function stateOverview(record, width) {
  if (!record) return [`${S.grey}no session found for this directory: start Claude Code here with the session-dock plugin${S.reset}`, ''];
  const { session: se = {}, usage: u = {}, git: g = {} } = record.view;
  const ov = (record.state && record.state.modules && record.state.modules.overview) || {};
  const d = ov.away || {};
  const commits = record.view.commits || [];
  const stale = Date.now() - record.updatedAt > 10 * 60 * 1000;
  const dot = se.busy && !stale ? `${S.yellow}● working${S.reset}` : `${stale ? S.grey : S.green}● ${stale ? 'idle (no update)' : 'idle'}${S.reset}`;
  const out = [`${dot} ${S.bold}${S.purple}${se.name || 'session'}${S.reset} ${S.grey}${se.model || ''}${S.reset}`];
  if (g.branch !== undefined && g.branch !== null) {
    const sync = g.ahead || g.behind ? ` ↑${g.ahead || 0} ↓${g.behind || 0}` : '';
    out.push(`⎇ ${g.branch || 'detached'}${sync} · ${g.dirty ? `${g.dirty} uncommitted` : 'clean'}`);
  }
  const hot = [['context', u.contextPercent], ...(u.rateLimits || []).map((r) => [label(r.kind), r.percentUsed])].filter(([, p]) => p >= 85);
  if (hot.length) out.push(`${esc('1;7;31')} ⚠ ${hot.map(([l, p]) => `${l} ${Math.round(p)}%`).join(' · ')} ${S.reset}`);
  out.push('', `${S.grey}context${S.reset} ${meter(u.contextPercent)}`);
  for (const r of u.rateLimits || []) out.push(`${S.grey}${label(r.kind).padEnd(7)}${S.reset} ${meter(r.percentUsed)}`);
  const spark = sparkline(ov.history);
  if (spark) out.push(`${S.grey}trend  ${S.reset} ${S.cyan}${spark}${S.reset}`);
  if (u.costUsd !== undefined) out.push(`${S.grey}cost${S.reset}    $${u.costUsd.toFixed(2)}`);
  out.push('', `${S.bold}${S.purple}Since you were away${S.reset} ${S.grey}(session-dock reset)${S.reset}`);
  const files = d.files || [];
  const bullets = [`${d.turns || 0} turns, ${Math.round((d.workMs || 0) / 60000)} min of work`];
  if (commits.length) bullets.push(`${commits.length} commits${d.pushes ? ', pushed' : ''}`, ...commits.slice(0, 4).map((c) => `  ${S.cyan}${c.slice(0, width - 4)}${S.reset}`));
  if (files.length) bullets.push(`${files.length} files edited: ${files.slice(-4).join(', ')}`);
  if (d.tests) bullets.push(`tests run ${d.tests}x`);
  if (d.agents) bullets.push(`${d.agents} subagents`);
  for (const b of bullets) out.push(...wrap(b.startsWith('  ') ? b : `${S.purple}•${S.reset} ${b}`, width, '  '));
  out.push('');
  return out;
}

function render(dir, width) {
  const file = cardPath(dir);
  let body;
  try {
    const stat = fs.statSync(file);
    body = renderMarkdown(fs.readFileSync(file, 'utf8'), width);
    const age = Math.round((Date.now() - stat.mtimeMs) / 60000);
    const ageText = age < 1 ? 'just now' : age < 60 ? `${age} min ago` : `${Math.round(age / 60)} h ago`;
    while (body.length && body[body.length - 1] === '') body.pop();
    body.push('', `${age > 60 ? S.yellow : S.grey}card updated ${ageText}${S.reset}`);
  } catch {
    body = renderMarkdown(`# No dock card\n\nCreate \`${path.relative(dir, file) || file}\` or run \`session-dock init\`.`, width);
  }
  return [...stateOverview(readState(dir), width), ...body, ...liveFacts(dir, width)].join('\n');
}

function width() {
  return Math.max(20, (process.stdout.columns || WIDTH_DEFAULT) - 2);
}

function watch(dir) {
  const draw = () => {
    process.stdout.write('\x1b[2J\x1b[H' + render(dir, width()) + '\n');
  };
  draw();
  const file = cardPath(dir);
  try { fs.watch(path.dirname(file), { persistent: true }, () => setTimeout(draw, 100)); } catch { /* polling below */ }
  setInterval(draw, REFRESH_MS);
  process.stdout.on('resize', draw);
}

function open(dir) {
  if (!process.env.TMUX) {
    console.error('session-dock open needs to run inside tmux.');
    process.exit(1);
  }
  if (wantedSession) process.env.SESSION_DOCK_SESSION = wantedSession;
  const cols = process.env.SESSION_DOCK_WIDTH || String(WIDTH_DEFAULT);
  const r = spawnSync('tmux', ['split-window', '-h', '-d', '-l', cols, '-c', dir, process.execPath, __filename, 'watch', dir], { stdio: 'inherit' });
  process.exit(r.status ?? 1);
}

function init(dir) {
  const file = cardPath(dir);
  if (fs.existsSync(file)) { console.log(`exists: ${file}`); return; }
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.copyFileSync(path.join(__dirname, '..', 'templates', 'dock.md'), file);
  console.log(`created: ${file}`);
}

// Ask the plugin (which polls ~/.claude/session-dock/cmd/<session id>.json) to start a new window.
function resetWindow(dir) {
  const record = readState(dir);
  if (!record) return false;
  const file = path.join(HOME_DIR, 'cmd', `${record.view.session.id}.json`);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, JSON.stringify({ reset: Date.now() }));
  return true;
}

function serve(dir) {
  const http = require('http');
  const port = Number(process.env.SESSION_DOCK_PORT || 7777);
  const page = fs.readFileSync(path.join(__dirname, '..', 'web', 'index.html'));
  http.createServer((req, res) => {
    const json = (code, body) => { res.writeHead(code, { 'content-type': 'application/json', 'cache-control': 'no-store' }); res.end(JSON.stringify(body)); };
    const url = req.url.split('?')[0];
    if (url === '/state') {
      const record = readState(dir);
      return json(200, record ? { ...record, card: readCard(dir) } : {});
    }
    if (url === '/sessions') return json(200, { rows: sessionRows(), current: (readState(dir) || { view: { session: {} } }).view.session.id });
    if (url === '/reset' && req.method === 'POST') { res.writeHead(resetWindow(dir) ? 204 : 404); return res.end(); }
    if (url !== '/') { res.writeHead(404); return res.end(); }
    res.writeHead(200, { 'content-type': 'text/html; charset=utf-8' });
    res.end(page);
  }).listen(port, '127.0.0.1', () => console.log(`session-dock: http://127.0.0.1:${port} (${dir})`));
}

// Recently active sessions (24 h), joined with Claude Code's live session files.
function sessionRows() {
  const live = new Map();
  const liveDir = path.join(HOME_DIR, '..', 'sessions');
  try {
    for (const n of fs.readdirSync(liveDir).filter((x) => x.endsWith('.json'))) {
      const info = readJson(path.join(liveDir, n));
      if (info && info.sessionId) live.set(info.sessionId, info);
    }
  } catch { /* no live sessions */ }
  const order = { busy: 0, waiting: 0, idle: 1, gone: 2 };
  const rows = [];
  for (const r of allRecords()) {
    if (Date.now() - r.updatedAt > 24 * 3600 * 1000) continue;
    const s = r.view.session;
    const info = live.get(s.id);
    const status = info ? (['busy', 'idle', 'waiting'].includes(info.status) ? info.status : 'idle') : 'gone';
    const m = String(s.model || '').match(/(opus|sonnet|haiku|fable)[-\s]?(\d+)?(?:[-.](\d{1,2})(?!\d))?/i);
    rows.push({
      id: s.id, status, name: (info && info.name) || s.name || String(s.id).slice(0, 8),
      project: path.basename(s.cwd || ''), model: m ? m[1].toLowerCase() + (m[2] ? ' ' + m[2] + (m[3] ? '.' + m[3] : '') : '') : '',
      context: r.view.usage && r.view.usage.contextPercent, branch: r.view.git && r.view.git.branch,
      updatedAt: Math.max(r.updatedAt || 0, (info && info.updatedAt) || 0),
    });
  }
  return rows.sort((a, b) => order[a.status] - order[b.status] || b.updatedAt - a.updatedAt);
}

function readCard(dir) {
  try { return fs.readFileSync(cardPath(dir), 'utf8'); } catch { return ''; }
}

const args = process.argv.slice(2);
const si = args.indexOf('--session');
if (si >= 0) { wantedSession = args[si + 1] || ''; args.splice(si, 2); }
const [cmd = 'render', dirArg] = args;
const dir = path.resolve(dirArg || process.cwd());
switch (cmd) {
  case 'open': open(dir); break;
  case 'watch': watch(dir); break;
  case 'render': console.log(render(dir, width())); break;
  case 'init': init(dir); break;
  case 'serve': serve(dir); break;
  case 'reset': console.log(resetWindow(dir) ? 'reset requested' : 'no session found for this directory'); break;
  default:
    console.error('usage: session-dock open|watch|render|init|serve|reset [dir] [--session <id>]');
    process.exit(2);
}
